{
  "name": "@familyhub/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "privacy:review": "tsx src/scripts/privacy-review.ts",
    "test": "node --import tsx --test tests/domain.test.ts tests/api.test.ts",
    "test:unit": "node --import tsx --test tests/domain.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.0.0",
    "bullmq": "^6.3.11",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.12",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.11.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0"
  }
}
