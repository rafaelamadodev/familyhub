{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run db:generate && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/cron/maintenance.ts": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/maintenance", "schedule": "0 3 * * *" }],
  "rewrites": [
    {
      "source": "/api/((?!cron/).*)",
      "destination": "/api?__apiPath=$1"
    }
  ]
}
